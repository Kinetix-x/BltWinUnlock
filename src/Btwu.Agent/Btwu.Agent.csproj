<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>btwu</AssemblyName>
    <RootNamespace>Btwu.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The tray mode shares this binary; console output is still used by every CLI command. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- This process allocates almost nothing outside startup, so a background GC thread buys no
         throughput and costs a thread plus its stack. Measured with tools\footprint\measure.ps1. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Btwu.Core\Btwu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The donation QR shown at the bottom of the panel. Embedded, not copied next to the exe:
         a stray image in the program folder is one more file that install/uninstall/portable-copy
         have to carry, and it is the one thing users delete. Embedded, it cannot go missing.
         (It also needs no Network access and no file path, so it still works from the lock screen's
         install directory.) -->
    <EmbeddedResource Include="Assets\alipay.jpg" />
  </ItemGroup>

</Project>
